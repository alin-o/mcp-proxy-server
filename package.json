{
  "name": "mcp-proxy-server",
  "version": "0.1.0",
  "author": "Adam Wattis",
  "license": "MIT",
  "description": "An MCP proxy server that aggregates and serves multiple MCP resource servers through a single interface",
  "private": true,
  "type": "module",
  "bin": {
    "mcp-proxy-server": "./build/sse.js",
    "generate-sse-token": "./build/generate-token.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "dev": "nodemon --watch 'src/**' --ext 'ts,json' --ignore 'src/**/*.spec.ts' --exec 'tsx src/index.ts'",
    "dev:sse": "nodemon --watch 'src/**' --ext 'ts,json' --ignore 'src/**/*.spec.ts' --exec 'tsx src/sse.ts'",
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\" && node -e \"require('fs').chmodSync('build/generate-token.js', '755')\" && npm run build:browser-client && cp src/browser-client/index.html build/browser-client/index.html && cp src/browser-client/favicon.svg build/browser-client/favicon.svg",
    "build:browser-client": "esbuild src/browser-client/browser-client.ts --bundle --outfile=build/browser-client/browser-client.bundle.js --format=esm",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js",
    "serve:browser": "nodemon --watch 'src/**' --ext 'ts,json' --ignore 'src/**/*.spec.ts' --exec 'tsx src/browser-server.ts'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "0.6.0",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.9",
    "blessed": "^0.1.81",
    "cors": "^2.8.5",
    "eventsource": "^3.0.2",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.25",
    "@types/commander": "^2.12.0",
    "@types/express": "^5.0.0",
    "@types/node": "^20.11.24",
    "commander": "^13.1.0",
    "esbuild": "^0.25.6",
    "nodemon": "^3.1.9",
    "tsx": "^4.19.3",
    "typescript": "^5.3.3"
  }
}
